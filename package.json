{
	"name": "docker-registry-ui",
	"private": true,
	"type": "module",
	"scripts": {
		"dev": "concurrently -n vite,air -c cyan,green \"vp dev\" \"sleep 3 & air\"",
		"dev:vite": "vp dev",
		"dev:air": "air",
		"build": "vp build",
		"preview": "./bin/container-hub serve",
		"lint": "knip && vue-tsc && vp check && eslint && go fmt ./... && golangci-lint run -c .golangci.yml ./...",
		"lint:fix": "vp check --fix && eslint --fix && go fmt ./..."
	},
	"dependencies": {
		"@formkit/auto-animate": "^0.10.2",
		"@headlessui/vue": "^1.7.23",
		"@inertiajs/vite": "^3.11.0",
		"@inertiajs/vue3": "^3.11.0",
		"@vueuse/core": "^15.0.0",
		"echarts": "^6.1.0",
		"highlight.js": "^11.12.0",
		"pinia": "^4.1.0",
		"semver": "^7.8.6",
		"tailwind-variants": "^4.0.1",
		"vue": "^3.5.45",
		"vue-echarts": "^8.3.2"
	},
	"devDependencies": {
		"@tailwindcss/vite": "^4.3.5",
		"@types/node": "^26.6.6",
		"@types/semver": "^7.8.0",
		"@typescript-eslint/parser": "^8.72.1",
		"@vitejs/plugin-vue": "^6.0.10",
		"concurrently": "^10.0.7",
		"esbuild": "^0.28.2",
		"eslint": "^10.14.0",
		"eslint-plugin-vue": "^10.12.0",
		"eslint-plugin-vuejs-accessibility": "^2.6.3",
		"knip": "^6.44.2",
		"laravel-vite-plugin": "^3.2.1",
		"rollup-plugin-visualizer": "^7.1.3",
		"tailwindcss": "^4.3.5",
		"typescript": "^6.0.3",
		"vite": "npm:@voidzero-dev/vite-plus-core@1.6.0",
		"vite-plugin-manifest-sri": "^0.2.0",
		"vite-plus": "1.6.0",
		"vue-eslint-parser": "^10.4.2",
		"vue-tsc": "^3.3.14"
	},
	"overrides": {
		"vite": "npm:@voidzero-dev/vite-plus-core@1.6.0"
	}
}
